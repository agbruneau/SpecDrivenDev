@startuml
left to right direction
skinparam packageStyle rectangle

actor "Chercheur" as R
actor "Pipeline CI" as CI

rectangle "EscapeBench" {
  usecase "UC-001\nGénérer la matrice de cellules" as UC001
  usecase "UC-002\nClasser l'échappement" as UC002
  usecase "UC-003\nExécuter une campagne de mesure" as UC003
  usecase "UC-004\nComparer valeur et pointeur" as UC004
